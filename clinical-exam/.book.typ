    [#strong[ختم زودهنگام] (premature closure)], [توقف فکر بعد از یافتن
    یک جواب], [یک علت پیدا شد، تحقیق ختم شد], [«آیا همه یافته‌ها را توضیح
    می‌دهد؟»],
