    دیافراگم #strong[هوای آزاد] هست؟],
    [#strong[E] همه چیز دیگر], [استخوان‌ها، نسج نرم، تیوب‌ها و
    لاین‌ها], [شکستگی قبرغه، هوای زیر جلد، جای تیوب‌ها],
  )]
