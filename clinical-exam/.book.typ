    table.hline(),
    [کوری تمام یک چشم], [همان چشم یا عصب بینایی], [انسداد شریان شبکیه،
    التهاب عصب],
    [#strong[کوری نیمه خارجی هر دو چشم] (bitemporal)], [#strong[چلیپای
    بینایی]], [تومور غده نخامیه],
    [#strong[کوری نیمه همسان هر دو چشم] (homonymous)], [پشت چلیپا
