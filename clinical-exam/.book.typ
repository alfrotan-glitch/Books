#pagebreak(to: "odd", weak: true)
#set page(
  numbering: "۱",
  header: context {
    let p = here().page()
    let starts = query(<chapter-start>).filter(m => m.location().page() == p)
    let before = query(heading.where(level: 1).before(here()))
    if starts.len() == 0 and before.len() > 0 {
      let ct = before.last().body
      set text(size: 8pt, fill: rgb("#666"))
      grid(columns: (1fr, 1fr),
        align(right)[معاینه کلینیکی], align(left)[#ct])
      v(-0.4em)
      line(length: 100%, stroke: 0.4pt + gold)
    }
  },
  footer: context {
    let p = here().page()
    set text(size: 9pt, fill: navy)
    align(center)[— #counter(page).display("۱") —]
  },
)
#counter(page).update(1)
// ── subject index with page numbers: mark every occurrence of an index term ──
#let idx-re = regex(json("build/index-terms.json").pattern)
#show idx-re: it => it + [#metadata(lower(it.text)) <idx>]
#let book-index(terms) = context {
  let stop = query(<backmatter>)
  let stop-page = if stop.len() > 0 { stop.first().location().page() } else { 100000 }
  let start-page = query(<chapter-start>).first().location().page()
  let marks = query(<idx>).filter(m => m.location().page() >= start-page and m.location().page() < stop-page and m.location().position().y > 2.1cm)
  let pages = (:)
  for m in marks {
    let k = m.value
    let n = counter(page).at(m.location()).first()
    let prev = pages.at(k, default: ())
    if n not in prev { prev.push(n) }
    pages.insert(k, prev)
  }
  let fmt(n) = numbering("۱", n)
  set par(justify: false, first-line-indent: 0pt, hanging-indent: 1em, spacing: 0.45em)
  set text(size: 9pt)
  columns(2, gutter: 1.2em, for t in terms {
    let ps = pages.at(lower(t), default: ())
    // collapse runs of consecutive pages into ranges
    let out = (); let i = 0
    while i < ps.len() {
      let j = i
      while j + 1 < ps.len() and ps.at(j + 1) == ps.at(j) + 1 { j += 1 }
      out.push(box(if j > i { fmt(ps.at(i)) + "–" + fmt(ps.at(j)) } else { fmt(ps.at(i)) }))
      i = j + 1
    }
    block(breakable: false)[*#t*#h(0.4em)#text(fill: rgb("#136f73"))[#out.join([، ])]]
  })
}


#heading(level: 1, supplement: none)[پیش از آغاز]
این کتاب را می‌شود به دو شکل خواند.

#strong[شکل اول: از آغاز تا پایان، مانند یک قصه.] بخش اول کتاب («ذهن
داکتر») طرز فکر را می‌سازد. اگر این پنج فصل را با حوصله بخوانید، فصل‌های
بعدی را سریع‌تر می‌فهمید. دلیلش این است که هر معاینه را به یک سؤال وصل
می‌کنید، نه به یک فهرست.

#strong[شکل دوم: در کنار بستر، مانند یک رهنما.] مریضی با تنگی نفس آمده؟
فصل تنفسی و رهیافت به عسرت تنفس را باز کنید. فردا امتحان عملی دارید؟
چک‌لیست‌های OSCE در ضمیمه منتظر شما اند.

در هر فصل چند جعبه تکرار می‌شوند. آن‌ها را بشناسید:

#story[
#strong[قصه کنار بستر.] هر فصل با یک مریض آغاز می‌شود. مریضان فرضی اند،
ولی شبیه کسانی اند که هر روز در شفاخانه‌های افغانستان می‌بینید.

]
#rule[
#strong[قانون کنار بستر.] جمله‌های کوتاهی که ارزش حفظ کردن دارند. همه
آن‌ها در آخر کتاب یک‌جا آمده‌اند.

]
#evidence[
#strong[شواهد چه می‌گویند.] اعداد و تحقیقات پشت یک ادعا: یک علامه چقدر
قابل اعتماد است و منبع آن کدام است.

]
#pitfall[
#strong[دام.] اشتباهاتی که داکتران خوب هم می‌کنند و بهای آن را مریض
می‌پردازد.

]
#expert[
#strong[برای متخصص.] عمق بیشتر برای کسی که می‌خواهد پشت پرده را ببیند:
فزیولوژی، مناقشه‌ها و رهنمودهای تازه. محصل می‌تواند در خواندن اول از آن
بگذرد.

]
#practice[
#strong[تمرین فردا صبح.] یک کار کوچک و مشخص. مهارت با خواندن ساخته
نمی‌شود؛ با تکرار ساخته می‌شود.

]
یک نکته دیگر: این کتاب جای استاد، رهنمودهای ملی و قضاوت کلینیکی شما را
نمی‌گیرد. کتاب نقشه است؛ راه را خود شما می‌روید.

#heading(level: 1, supplement: [بخش اول])[ذهن داکتر]
#heading(level: 1, supplement: [فصل اول])[چرا هنوز معاینه؟]
#story[
ساعت دو شب است، در یک شفاخانه ولایتی. برق رفته و جنراتور تازه خاموش شده
است. داکتر نوکریوال، که شش ماه پیش فارغ شده، کنار بستر مردی ۵۸ ساله
ایستاده است. مرد دست خود را روی سینه فشار می‌دهد.

داکتر جوان فکر می‌کند: #emph[«ECG کار نمی‌کند. لابراتوار تا صبح بسته است.
چه کنم؟»]

داکتر مسن‌تر بخش از دهلیز می‌آید. نه ماشین می‌خواهد، نه کاغذ. کنار مریض
می‌نشیند و سه سؤال می‌پرسد:

«درد چطور شروع شد؛ آهسته یا مثل برق؟»

«مثل برق. مثل این که چیزی در سینه‌ام پاره شد.»

«درد به کجا می‌رود؟»

«به پشتم، بین شانه‌هایم.»

«فشار خون بالا دارید؟»

«بلی، ولی دوا را چند ماه است که نخورده‌ام.»

بعد فشار خون را در #strong[هر دو بازو] اندازه می‌کند. در بازوی راست ۱۶۵
است و در بازوی چپ ۱۳۰.

داکتر مسن رو به همکار جوانش می‌گوید: «این را انشقاق ابهر (aortic
dissection) حساب کن تا وقتی که خلافش ثابت شود. به هیچ وجه ضد تخثر
(anticoagulant) ندهید. فشارش را پایین بیاورید و همین حالا راجع کنید تا
CT شود.»

در این قصه هیچ ماشینی کار نکرد. تشخیص با سه سؤال و یک فشارسنج ساخته شد.

]
#bigidea[
#strong[تشخیص در گفتگو شکل می‌گیرد، در معاینه آزموده می‌شود و در لابراتوار
تأیید می‌گردد.]

]
== سه ابزار، یک هدف
<سه-ابزار-یک-هدف>
هر داکتر برای رسیدن به تشخیص سه ابزار دارد:

+ #strong[تاریخچه:] آنچه مریض می‌گوید.
+ #strong[معاینه:] آنچه داکتر می‌بیند، لمس می‌کند و می‌شنود.
+ #strong[معاینات تکمیلی:] آنچه لابراتوار و تصویربرداری نشان می‌دهند.

محصلان طب اکثراً فکر می‌کنند ابزار سوم قوی‌ترین است، چون اعداد و عکس‌هایش
دقیق به نظر می‌رسند. اما تحقیقات چیز دیگری می‌گویند.

#evidence[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[تشخیص از کجا می‌آید؟]

]
- در سال ۱۹۷۵ Hampton و همکارانش ۸۰ مریض جدید کلینیک داخله را بررسی
  کردند. در #strong[۶۶ مریض (حدود ۸۲٪)] تشخیص درست تنها بعد از خواندن
  مکتوب راجع‌کننده و گرفتن تاریخچه معلوم شد. معاینه فزیکی در ۷ مریض و
  لابراتوار در ۷ مریض دیگر تشخیص را مشخص کرد.
- در سال ۱۹۹۲ Peterson و همکارانش همین سؤال را در ۸۰ مریض دیگر آزمودند.
  تاریخچه در #strong[۷۶٪]، معاینه در #strong[۱۲٪] و لابراتوار در
  #strong[۱۱٪] مریضان به تشخیص نهایی رهنمایی کرد.

#emph[منابع: Hampton JR et al.~BMJ 1975;2:486--9؛ Peterson MC et
al.~West J Med 1992;156:163--5.]

]
این اعداد را حفظ کنید، چون تمام این کتاب بر آن‌ها استوار است: #strong[از
هر پنج تشخیص، تقریباً چهارتا در گفتگو پیدا می‌شود.]

آیا این یعنی معاینه اهمیت ندارد؟ نه. معاینه در همان تحقیق Peterson
اعتماد داکتر به تشخیصش را به طور محسوس بالا برد. در بسیاری مریضان هم
معاینه تشخیص را #strong[تغییر داد] یا یک خطر را آشکار ساخت. در قصه آغاز
فصل، تاریخچه شک را ساخت و معاینه آن را جدی کرد.

#rule[
#strong[قانون ۱:] اگر بعد از تاریخچه نمی‌دانید دنبال چه هستید، معاینه هم
به شما نخواهد گفت.

]
== ماشین جای چشم را نمی‌گیرد
<ماشین-جای-چشم-را-نمیگیرد>
در دهه‌های اخیر ماشین‌های تشخیصی بسیار پیشرفت کرده‌اند. CT در چند دقیقه
تمام بدن را نشان می‌دهد و معاینات خون صدها عدد می‌دهند. پس چرا هنوز گوشی
طبی (stethoscope) به گردن بیندازیم؟

#strong[دلیل اول: ماشین جواب می‌دهد، ولی سؤال را نمی‌پرسد.] CT بطن تنها
وقتی کمک می‌کند که کسی فکر کند باید بطن را دید. این فکر از کنار بستر
می‌آید.

#strong[دلیل دوم: معاینه نکردن، خود یک اشتباه طبی است.]

#evidence[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[وقتی معاینه نمی‌شود چه اتفاق می‌افتد؟]

]
در سال ۲۰۱۵ Verghese و همکارانش ۲۰۸ واقعه را جمع کردند که در آن‌ها یک
اشتباه در معاینه فزیکی به مریض آسیب رسانده بود:

- در #strong[۶۳٪] اصلاً معاینه لازم #strong[اجرا نشده بود].
- در #strong[۱۴٪] علامه دیده شده بود، ولی #strong[غلط تفسیر شده بود].
- در #strong[۱۱٪] علامه #strong[جستجو نشده بود] یا از نظر افتاده بود.
- نتیجه در #strong[۷۶٪] واقعات تشخیص از دست رفته یا ناوقت بود.

#emph[منبع: Verghese A et al.~Am J Med 2015;128:1322--4.]

]
به عبارت دیگر، بیشتر اشتباهات از ندانستن نیست؛ از #strong[نگاه نکردن]
است. کسی که لباس مریض را کنار نمی‌زند، زونا (herpes zoster) را درد قلبی
تشخیص می‌دهد. کسی که پاهای مریض دیابتیک را نمی‌بیند، زخم را تا وقتی که قطع
لازم شود نمی‌بیند.

#strong[دلیل سوم: در افغانستان دست‌های داکتر همیشه حاضر اند.] در بسیاری
شفاخانه‌ها و کلینیک‌های کشور برق می‌رود، ماشین خراب می‌شود و معاینه برای
مریض گران است. در یک کلینیک ولسوالی شاید تنها ابزار شما گوشی طبی،
فشارسنج، ترمامتر و دو دست تان باشد. داکتری که با این ابزارها خوب فکر
کند، در هر جایی داکتر خوب است.

#rule[
#strong[قانون ۲:] بیشتر اشتباهات معاینه از ندانستن نیست، از نگاه نکردن
است. لباس را کنار بزنید.

]
#pitfall[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[دام: «معاینات را بفرست، بعد می‌بینیم.»]

]
فرستادن ده معاینه بدون فرضیه، ماهیگیری در تاریکی است. هر معاینه‌ای که
بدون سؤال فرستاده شود، به احتمال زیاد یک عدد «کمی غیرنارمل» برمی‌گرداند.
آن عدد مریض را نگران می‌کند، معاینات بیشتر می‌خواهد و گاهی شما را از تشخیص
اصلی دور می‌سازد. #strong[اول فکر کنید، بعد معاینه بفرستید.]

]
== معاینه عکس نیست، فلم است
<معاینه-عکس-نیست-فلم-است>
یک معاینه، تصویر یک لحظه است. اما مرض در حرکت است.

مریضی که صبح با درد مبهم دور ناف آمده بود، شام درد را در حفره حرقفی راست
حس می‌کند. طفلی که ساعت ده شب تنها تب داشت، ساعت دو شب گردنش شخ شده است.
خانمی که بعد از ولادت فشار نارمل داشت، دو ساعت بعد نبضش تند شده و فشارش
پایین آمده است.

داکتر خوب #strong[دوباره برمی‌گردد]. معاینه مکرر یکی از ارزان‌ترین و
قوی‌ترین ابزارهای طب است. تغییر یک علامه در طول زمان اکثراً از خود علامه
مهم‌تر است.

#rule[
#strong[قانون ۳:] یک معاینه عکس است؛ معاینات مکرر فلم اند. مرض را در فلم
بشناسید.

]
== مهارت مرکب
<مهارت-مرکب>
فرض کنید هر روز تنها یک قلب را با دقت اصغا کنید؛ با تمرکز، نه با عجله.
در یک سال بیش از ۳۰۰ قلب شنیده‌اید. بعد از پنج سال، مغز شما یک کتابخانه
بیش از هزار و پنجصد آوازی دارد. آن وقت یک مرمر (murmur) نرم را می‌شنوید
که همکار شما نمی‌شنود. شما گوش بهتری ندارید؛ #strong[حافظه بهتری] دارید.

مهارت کلینیکی مانند پول در بانک است: #strong[سود مرکب] دارد. هر مریضی که
با دقت معاینه می‌کنید، مریض بعدی را آسان‌تر می‌سازد. هر مریضی که با عجله
معاینه می‌کنید، فرصتی است که دیگر برنمی‌گردد.

به همین دلیل این کتاب در آخر هر فصل یک «تمرین فردا صبح» دارد. تمرین‌ها
کوچک اند، چون کار کوچکی که هر روز تکرار شود، از کار بزرگی که هرگز شروع
نشود، بهتر است.

#rule[
#strong[قانون ۴:] هر مریض را طوری معاینه کنید که انگار مریض آخر شما است؛
هم به خاطر او، هم به خاطر همه مریضان بعدی.

]
#expert[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[برای متخصص: چرا معاینه کلینیکی دوباره مهم شده است]

]
در دهه‌های اخیر در بسیاری مراکز علمی جهان از «زوال معاینه کنار بستر» سخن
گفته می‌شد. نتیجه آن معاینات بیشتر، مصرف بیشتر و گاهی تشخیص ناوقت‌تر بود.
از آن وقت سه جریان معاینه کلینیکی را دوباره در مرکز آموزش طب گذاشته‌اند:

+ #strong[طب مبتنی بر شواهد در کنار بستر (Rational Clinical
  Examination).] یک سلسله مقالات در مجله JAMA، و کتاب‌هایی مانند
  #emph[Evidence-Based Physical Diagnosis] از McGee، برای علایم کلینیکی
  حساسیت، ویژگی و نسبت احتمال (likelihood ratio) را اندازه کرده‌اند.
  امروز می‌دانیم که یک علامه چقدر احتمال یک مرض را بالا یا پایین می‌برد.
+ #strong[الترا ساوند کنار بستر (POCUS).] POCUS معاینه را حذف نمی‌کند،
  بلکه آن را دقیق‌تر می‌سازد. این هم با یک سؤال کلینیکی آغاز می‌شود.
+ #strong[مصونیت مریض.] اشتباهات تشخیصی حالا یک اولویت جهانی مصونیت مریض
  اند. سهم بزرگی از آن‌ها به تاریخچه و معاینه ناقص برمی‌گردد.

در این کتاب هر جا شواهد محکم موجود باشد، با عدد و منبع آمده است. هر جا
شواهد ضعیف است، آن را هم صادقانه گفته‌ایم.

]
== سه ستون این کتاب
<سه-ستون-این-کتاب>
تمام این کتاب بر سه ستون ساخته شده است:

#strong[۱. فکر احتمالی.] هیچ علامه‌ای تشخیص را «ثابت» نمی‌کند. هر علامه
تنها احتمال را بالا یا پایین می‌برد. داکتر ماهر مثل یک قاضی عاقل است:
شواهد را وزن می‌کند و تا وقتی که شواهد کافی نباشد، حکم نمی‌دهد. فصل چهارم
این طرز فکر را به تفصیل می‌سازد.

#strong[۲. دقت.] معاینه نیم‌کاره از معاینه نکردن خطرناک‌تر است، چون
اطمینان کاذب می‌دهد. هر معاینه در این کتاب قدم‌به‌قدم آمده است، با دام‌هایی
که باید از آن‌ها دوری کنید.

#strong[۳. انسانیت.] مریض یک «کیس» نیست؛ یک انسان است که از ترس، درد یا
شرم به شما اعتماد کرده است. در فرهنگ ما، اجازه گرفتن، پوشاندن بدن، حضور
محرم و احترام به بزرگان بخشی از معاینه خوب اند، نه مانع آن. مریضی که
احترام ببیند، حقیقت را می‌گوید، و حقیقت همان چیزی است که برای تشخیص لازم
دارید.

#summary[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[خلاصه در یک نگاه]

]
- از هر پنج تشخیص تقریباً چهارتا از تاریخچه می‌آید. معاینه آن را می‌آزماید
  و لابراتوار تأیید می‌کند.
- بیشترین اشتباهات معاینه از اجرا نکردن آن است، نه از ندانستن.
- ماشین جواب می‌دهد، ولی سؤال از کنار بستر می‌آید.
- معاینه مکرر تغییر را نشان می‌دهد، و تغییر اکثراً مهم‌ترین علامه است.
- مهارت کلینیکی سود مرکب دارد؛ هر مریض دقیق، مریض بعدی را آسان‌تر می‌سازد.
- این کتاب بر سه ستون استوار است: فکر احتمالی، دقت و انسانیت.

]
#practice[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[تمرین فردا صبح]

]
پیش از این که برای مریض بعدی معاینه لابراتواری بنویسید، یک لحظه بایستید
و در کاغذ یا ذهن تان این جمله را کامل کنید:

«این معاینه را می‌فرستم، چون فکر می‌کنم ممکن است ………… باشد، و اگر نتیجه
………… بود، کار من ………… تغییر می‌کند.»

اگر نتوانستید جمله را کامل کنید، شاید آن معاینه لازم نباشد.

]
#heading(level: 1, supplement: [فصل دوم])[هنر شنیدن — گرفتن تاریخچه]
#story[
زمستان است. خانم معلمی ۳۴ ساله در یک ماه سه بار به کلینیک آمده است.
شکایتش سردردی است. داکتر اول برایش پاراستامول داده، داکتر دوم عینک
پیشنهاد کرده و داکتر سوم گفته است «فشار عصبی است».

داکتر چهارم کار دیگری می‌کند. می‌گوید: «از اول بگویید. من گوش می‌دهم.» بعد
خاموش می‌ماند.

خانم دو دقیقه حرف می‌زند. در میان حرف‌هایش این جمله‌ها می‌آیند:

«صبح‌ها بدتر است… در مکتب کمی بهتر می‌شوم… شوهرم هم این روزها سردردی دارد…
پسرم دیروز استفراغ کرد… از وقتی که بخاری نو را در اتاق خواب گذاشتیم…»

داکتر سر بلند می‌کند: «بخاری با چه می‌سوزد؟ دودکش دارد؟»

تشخیص #strong[مسمومیت با کاربن مونوکساید] بود. سه داکتر اول سؤال درست را
نپرسیده بودند. داکتر چهارم هم آن را نپرسید؛ #strong[مریض خودش گفت].
داکتر تنها برایش فرصت داد.

]
#bigidea[
#strong[مریض تشخیص را به شما می‌گوید، اگر فرصت گفتن بدهید.]

]
== چرا تاریخچه یک هنر است
<چرا-تاریخچه-یک-هنر-است>
گرفتن تاریخچه پر کردن یک فورم نیست. یک گفتگو است میان دو انسان: یکی
نگران است و دیگری می‌خواهد کمک کند. این گفتگو دو هدف دارد:

+ #strong[جمع‌آوری معلومات] برای ساختن تشخیص.
+ #strong[ساختن اعتماد] تا مریض حقیقت را بگوید، دوا را بخورد و دوباره
  برگردد.

این دو هدف از هم جدا نیستند. مریضی که به شما اعتماد ندارد، مهم‌ترین قسمت
قصه را نمی‌گوید: الکول، اعتیاد، خشونت خانوادگی، ترس از سرطان، یا این که
دوای قبلی را اصلاً نخورده است.

== پیش از اولین سؤال
<پیش-از-اولین-سؤال>
بیشتر اشتباهات تاریخچه پیش از اولین سؤال شروع می‌شوند.

#strong[جای مناسب.] اگر ممکن است، جایی را انتخاب کنید که دیگران نشنوند.
در یک اتاق پُر یا یک دهلیز شلوغ، مریض تنها نیمی از حقیقت را می‌گوید.

#strong[بنشینید.] وقتی داکتر می‌نشیند، مریض فکر می‌کند داکتر وقت بیشتری
صرف کرده است، حتی اگر وقت یکسان باشد. نشستن ارزان‌ترین راه ساختن اعتماد
است.

#strong[سلام، نام و نقش.] «السلام علیکم. من داکتر احمدی هستم، داکتر
نوکریوال این بخش.» بعد نام مریض را بپرسید و با همان نام صدایش کنید. برای
بزرگان از القاب احترامی استفاده کنید: کاکا، خاله، حاجی صاحب، مادر جان.

#strong[حریم و فرهنگ.] با خانم‌ها، اگر ممکن است، یک همکار خانم یا یکی از
اعضای خانواده خودش حاضر باشد. اما به یاد داشته باشید: #strong[حضور شوهر
یا خسر گاهی مانع حقیقت است.] در موضوعات حساس (حاملگی، خشونت، امراض
نسایی) پیدا کردن یک فرصت کوتاه برای حرف زدن تنها با مریض، اکثراً مهم‌ترین
کار شما است.

#strong[زبان.] اگر مریض پشتو، ازبکی یا زبان دیگری صحبت می‌کند که شما خوب
نمی‌فهمید، ترجمان بخواهید. طفل خورد مریض ترجمان مناسبی نیست.

#rule[
#strong[قانون ۵:] بنشینید. داکتری که ایستاده است، به مریض می‌گوید «عجله
دارم».

]
== دو دقیقه طلایی
<دو-دقیقه-طلایی>
بعد از سلام، یک سؤال باز بپرسید:

#quote(block: true)[
«بفرمایید، چه مشکلی شما را به اینجا آورده است؟»
]

بعد #strong[خاموش بمانید]. این سخت‌ترین قسمت تاریخچه است.

#evidence[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[داکتران چقدر زود حرف مریض را قطع می‌کنند؟]

]
- در یک تحقیق در امریکا (Marvel و همکاران، ۱۹۹۹) داکتران به طور اوسط بعد
  از #strong[۲۳ ثانیه] حرف مریض را قطع کردند. تنها #strong[۲۸٪] مریضان
  فرصت یافتند که همه نگرانی‌های خود را بگویند.
- در یک تحقیق تازه‌تر (Singh Ospina و همکاران، ۲۰۱۹) میانه زمان پیش از
  قطع کردن تنها #strong[۱۱ ثانیه] بود.
- اما وقتی حرف مریضان قطع نشد (Langewitz و همکاران، ۲۰۰۲)، آن‌ها به طور
  اوسط تنها #strong[۹۲ ثانیه] حرف زدند و #strong[۷۸٪] آن‌ها در کمتر از دو
  دقیقه حرف خود را تمام کردند.

#emph[منابع: Marvel MK et al.~JAMA 1999;281:283--7؛ Singh Ospina N et
al.~J Gen Intern Med 2019;34:36--40؛ Langewitz W et al.~BMJ
2002;325:682--3.]

]
ترس از این که مریض «تا شام حرف بزند»، در بیشتر موارد بی‌جا است. دو دقیقه
سرمایه‌گذاری کوچکی است. در عوض آن نقشه تمام مشکل را به دست می‌آورید، نه
تنها اولین تکه آن را.

در این دو دقیقه:

- #strong[با چشم و سر] نشان دهید که گوش می‌دهید.
- #strong[ننویسید]، یا تنها چند کلمه یادداشت کنید. چشم شما باید به مریض
  باشد، نه به کاغذ.
- #strong[کلمات خود مریض] را به خاطر بسپارید. «مثل این که کسی روی سینه‌ام
  نشسته باشد» ارزش تشخیصی بیشتری از «درد صدری» دارد.

وقتی مریض خاموش شد، نپرسید «چیز #emph[دیگری] هم هست؟» بپرسید:

#quote(block: true)[
«#strong[دیگر چه] شما را اذیت می‌کند؟»
]

این تفاوت کوچک به نظر می‌رسد، اما نیست.

#evidence[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[یک کلمه، یک تفاوت بزرگ]

]
Heritage و همکارانش (۲۰۰۷) در ۲۰ کلینیک امریکا دو سؤال را آزمودند. وقتی
داکتر در انگلیسی پرسید «Is there #strong[some]thing else?» (چیز دیگری هم
هست؟)، نگرانی‌هایی که مریضان ناگفته از کلینیک می‌بردند، نسبت به ملاقات‌های
عادی #strong[حدود ۷۸٪ کم شد]. اما سؤال «Is there #strong[any]thing
else?» (کدام چیز دیگر؟) تفاوت معناداری ایجاد نکرد. سؤال اول جواب «نه» را
آسان می‌سازد؛ سؤال دوم فرض می‌کند که چیز دیگری هم هست.

#emph[منبع: Heritage J et al.~J Gen Intern Med 2007;22:1429--33.]

]
#rule[
#strong[قانون ۶:] سؤال باز بپرسید، بعد دو دقیقه خاموش بمانید. در این دو
دقیقه بیشتر از بیست سؤال بسته یاد می‌گیرید.

]
== قیف: از باز به بسته
<قیف-از-باز-به-بسته>
یک تاریخچه خوب شکل قیف دارد:

+ #strong[سؤال باز:] «از اول بگویید.»
+ #strong[سؤال متمرکز:] «درباره درد بیشتر بگویید؛ چطور است؟»
+ #strong[سؤال بسته:] «درد به بازوی چپ می‌رود؟» «عرق کردید؟»

محصلان اکثراً از آخر قیف شروع می‌کنند: یک فهرست بلند سؤال‌های «بلی یا نه».
این دو ضرر دارد. اول، مریض تنها به سؤال‌های شما جواب می‌دهد و آنچه را
نپرسیده‌اید، هرگز نمی‌شنوید. دوم، سؤال بسته جواب را تلقین می‌کند. مریضی که
ترسیده است، به سؤال «درد مثل فشار است؟» اکثراً «بلی» می‌گوید.

#pitfall[
#block(sticky: true, above: 0pt, below: 0.65em)[
#strong[دام: سؤال تلقینی (leading question)]

]
«درد به بازوی چپ تان می‌رود، نه؟» جواب را پیش از مریض می‌دهد. بپرسید: «درد
جای دیگری هم می‌رود؟» اگر جواب واضح نبود، بعد مشخص بپرسید، و هر دو طرف را
پیشنهاد کنید: «به طرف بازو می‌رود یا به طرف پشت، یا هیچ جا؟»

]
== هفت خانه تاریخچه
<هفت-خانه-تاریخچه>
تاریخچه کامل را مانند خانه‌ای با هفت اتاق تصور کنید. در هر مریض از همه
اتاق‌ها می‌گذرید، ولی در بعضی اتاق‌ها بیشتر می‌مانید.

