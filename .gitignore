lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/

# Local workspace directories (keep directory structure via .gitkeep)
inbox/*
!inbox/.gitkeep
output/*
!output/.gitkeep
debug/*
!debug/.gitkeep
logs/*
!logs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
